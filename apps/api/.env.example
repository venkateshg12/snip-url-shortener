PORT=4000
# docker compose Postgres (host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/url_shortener
# Used by `pnpm --filter api test`; migrated and truncated by the test setup
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/url_shortener_test
# BullMQ + rate limits (noeviction)
REDIS_QUEUE_URL=redis://localhost:6379
# URL cache (allkeys-lru)
REDIS_CACHE_URL=redis://localhost:6380
# Short-code permutation keys (phase 2). Dev-only values; generate your own for production:
#   pnpm --filter api gen:shortcode-keys
SHORTCODE_KEYS=2918769150155,678296251218,1797563467723,1470713795235
SHORT_BASE_URL=http://localhost:4000
# Auth (phase 6): two different secrets, 32+ random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_REFRESH_SECRET=change-me-too-a-different-long-random-string
BCRYPT_ROUNDS=12
# Click analytics (phase 7): keys the daily visitor hash. 32+ random characters
VISITOR_HASH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Bull Board at /admin/queues (development only; both must be set)
# BULL_BOARD_USER=admin
# BULL_BOARD_PASSWORD=
