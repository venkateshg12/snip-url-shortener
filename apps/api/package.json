{
    "name": "api",
    "version": "0.0.0",
    "private": true,
    "type": "commonjs",
    "main": "src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "node build.mjs",
        "start": "node --enable-source-maps dist/index.js",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev && prisma generate",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "gen:shortcode-keys": "tsx scripts/genShortcodeKeys.ts",
        "worker": "tsx watch src/worker.ts",
        "start:worker": "node --enable-source-maps dist/worker.js",
        "gen:tz-aliases": "tsx scripts/genTimeZoneAliases.ts"
    },
    "dependencies": {
        "@bull-board/api": "9.10.1",
        "@bull-board/express": "9.10.1",
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "bcrypt": "6.0.0",
        "bowser": "2.14.1",
        "bullmq": "6.3.8",
        "cookie-parser": "1.4.7",
        "cors": "2.8.6",
        "dotenv": "18.0.3",
        "express": "5.2.1",
        "helmet": "8.3.0",
        "ioredis": "6.0.0",
        "jsonwebtoken": "9.0.3",
        "pg": "8.23.0",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "prom-client": "15.1.3",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/types": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/autocannon": "^7.12.7",
        "@types/bcrypt": "6.0.0",
        "@types/cookie-parser": "1.4.10",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/node": "22.20.4",
        "@types/pg": "8.23.1",
        "@types/supertest": "7.2.1",
        "autocannon": "8.0.0",
        "esbuild": "0.28.2",
        "eslint": "9.39.5",
        "prisma": "7.10.0",
        "supertest": "7.3.0",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vitest": "5.0.1"
    }
}
