{
    "name": "url-shortener",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,yml,yaml}\""
    },
    "devDependencies": {
        "prettier": "3.9.9",
        "turbo": "2.11.3",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.10.0"
}
